{
  "name": "kxco-pq-attest",
  "version": "2.1.1",
  "description": "Post-quantum document signing any counterparty can verify offline, years later. ML-DSA-87 or ML-DSA-65 (NIST FIPS 204) over any payload in a self-contained JSON envelope, with optional anchoring on Armature L1 for a timestamp the chain itself verified.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "ml-dsa-87",
    "attestation",
    "nist",
    "fips-204",
    "cloudflare-workers",
    "kxco",
    "signing",
    "verification",
    "payload-signing",
    "self-contained",
    "regulatory",
    "identity",
    "credential",
    "compliance",
    "pqc-migration",
    "digital-signature",
    "document-signing",
    "e-signature",
    "timestamping",
    "non-repudiation",
    "tamper-evident",
    "audit-trail",
    "crypto-agility"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-attest.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-attest/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "src",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "kxco-post-quantum": "^1.6.0",
    "kxco-pq-network": "^1.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/attest.test.js test/envelope-v2.test.js test/ml-dsa-87.test.js test/property.test.js",
    "evidence": "node scripts/build-evidence.mjs"
  },
  "funding": "https://kxco.ai",
