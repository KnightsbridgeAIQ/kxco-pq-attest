  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/attest.test.js test/envelope-v2.test.js"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
