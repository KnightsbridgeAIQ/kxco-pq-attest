{
  "name": "kxco-pq-attest",
  "version": "2.0.0",
  "description": "Post-quantum document signing and on-chain attestation. ML-DSA-65 (FIPS 204) over any payload, producing a self-contained JSON envelope a counterparty verifies offline. Anchor the envelope on Armature L1 for a permanent timestamped record the chain itself has verified.",
