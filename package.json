    "post-quantum",
    "pqc",
    "ml-dsa",
    "attestation",
    "nist",
    "fips-204",
    "cloudflare-workers",
    "kxco",
    "signing",
    "verification",
    "payload-signing",
    "self-contained",
    "regulatory",
    "identity",
    "credential",
    "compliance"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-attest.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-attest/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
